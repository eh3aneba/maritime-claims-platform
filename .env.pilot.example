# Private design-partner pilot. Do not expose this compose stack directly to the public internet.
APP_ENV=pilot
APP_NAME="Maritime Claims & Risk Intelligence Platform"
API_V1_PREFIX=/api/v1

# Browser/API origins for a localhost/private workstation pilot.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=maritime_claims
POSTGRES_USER=maritime
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://maritime:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/maritime_claims
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=25

# Required for pilot/staging/production preflight.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_ISSUER=mcri-api
TOKEN_AUDIENCE=mcri-web
AUTH_COOKIE_NAME=mcri_access_token

PROCESSING_MAX_ATTEMPTS=3
PROCESSING_POLL_SECONDS=2

# Local-only, bounded OCR. The worker includes English and Persian Tesseract data.
OCR_ENABLED=true
OCR_LANGUAGES=eng+fas
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=120

# External AI remains disabled in pilot. Sprint 11A permits it only in a separately governed staging environment.
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=2000
AI_PROMPT_BUNDLE_VERSION=2026-08-20.1
AI_SCHEMA_BUNDLE_VERSION=2026-08-20.1
ALLOW_EXTERNAL_AI_RESTRICTED=false

# Synthetic MT ORION design-partner demo credentials.
MCRI_DEMO_ORG_NAME="Pilot Marine Insurer"
MCRI_DEMO_ORG_SLUG=pilot
MCRI_DEMO_EMAIL=manager@demo.mcri.app
MCRI_DEMO_PASSWORD=REPLACE_WITH_DEMO_PASSWORD_12_CHARS_MIN
