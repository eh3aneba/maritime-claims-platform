# Application
APP_ENV=development
APP_NAME="Maritime Claims & Risk Intelligence Platform"
API_V1_PREFIX=/api/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=maritime_claims
POSTGRES_USER=maritime
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://maritime:change-me-in-local-env@db:5432/maritime_claims

# Security - replace before any shared/staging deployment
SECRET_KEY=replace-with-a-long-random-secret

# File storage abstraction (local for the private pilot; S3-compatible later)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/documents
MAX_UPLOAD_MB=25

# Fail-closed malware scanning for Docker uploads.
# clamd remains internal to the Compose network and is not published to the host.
MALWARE_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_ISSUER=mcri-api
TOKEN_AUDIENCE=mcri-web
AUTH_COOKIE_NAME=mcri_access_token

# Background document processing
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_POLL_SECONDS=2

# AI gateway (disabled by default; enable explicitly for external processing)
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
AI_MAX_INPUT_CHARS=60000
ALLOW_EXTERNAL_AI_RESTRICTED=false
