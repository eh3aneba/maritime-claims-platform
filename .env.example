# Application
APP_ENV=development
APP_NAME=Maritime Claims & Risk Intelligence Platform
API_V1_PREFIX=/api/v1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=maritime_claims
POSTGRES_USER=maritime
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://maritime:change-me-in-local-env@db:5432/maritime_claims

# Security - replace before any shared/staging deployment
SECRET_KEY=replace-with-a-long-random-secret

# File storage abstraction (local for Sprint 2; S3-compatible later)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/documents

# Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOKEN_ISSUER=mcri-api
TOKEN_AUDIENCE=mcri-web
AUTH_COOKIE_NAME=mcri_access_token

MAX_UPLOAD_MB=25

# Background document processing
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_POLL_SECONDS=2

# AI gateway (disabled by default; enable explicitly for external processing)
AI_PROVIDER=disabled
AI_MODEL=
OPENAI_API_KEY=
AI_MAX_INPUT_CHARS=60000
ALLOW_EXTERNAL_AI_RESTRICTED=false
